{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CORS_ORIGIN",
    "NODE_ENV",
    "AUTO_CONFIRM_PAYMENTS",
    "MONGODB_URI",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "DISABLE_MOCK_AUTH",
    "ALLOWED_ORIGINS",
    "FRAUD_HIGH_VALUE_THRESHOLD",
    "DELIVERY_FEE_PER_5KM",
    "NOTIFICATION_SERVICE_URL",
    "MTN_MOMO_TARGET_ENV",
    "MTN_MOMO_BASE_URL",
    "MTN_MOMO_CURRENCY",
    "MTN_MOMO_CALLBACK_URL",
    "MTN_MOMO_COLLECTION_API_KEY",
    "MTN_MOMO_COLLECTION_USER_ID",
    "MTN_MOMO_COLLECTION_API_SECRET",
    "MTN_MOMO_DISBURSEMENT_API_KEY",
    "MTN_MOMO_DISBURSEMENT_USER_ID",
    "MTN_MOMO_DISBURSEMENT_API_SECRET",
    "ESCROW_RELEASE_DELAY_HOURS",
    "ADMIN_EMAIL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SENDGRID_API_KEY",
    "PRODUCT_SERVICE_URL",
    "DELIVERY_SERVICE_URL",
    "WALLET_SERVICE_URL",
    "MARKET_SERVICE_URL",
    "ORDER_SERVICE_PUBLIC_URL",
    "ADMIN_USER_ID",
    "LIVE_STREAM_PROVIDER",
    "CLOUDFLARE_STREAM_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "MUX_TOKEN_ID",
    "MUX_TOKEN_SECRET",
    "B2B_CREDIT_DEFAULT_LIMIT",
    "AFFILIATE_MAX_COMMISSION_RATE",
    "PRICE_INDEX_COMPUTE_ENABLED",
    "SELLER_TIER_COMPUTE_ENABLED",
    "INVOICE_GCS_BUCKET",
    "FRONTEND_PUBLIC_URL",
    "USER_SERVICE_URL",
    "NEXT_PUBLIC_LIVE_STREAM_PROVIDER",
    "NEXT_PUBLIC_AFFILIATE_ENABLED",
    "NEXT_PUBLIC_B2B_ENABLED",
    "NEXT_PUBLIC_EXPORT_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}
